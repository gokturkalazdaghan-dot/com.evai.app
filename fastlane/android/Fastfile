# fastlane/android/Fastfile

default_platform(:android)

platform :android do
  desc "Play Console 'internal testing' track'ine AAB yükler"
  lane :deploy_internal do
    upload_to_play_store(
      package_name: "com.eva.app",
      json_key: "play-service-account.json",
      aab: "../../android/app/build/outputs/bundle/release/app-release.aab",
      track: "internal",
      # release_status "draft" olarak bırakılıyor — Play Console'da otomatik
      # yayınlama yerine ekibin son bir manuel "Release" tıklaması gerekiyor.
      # Bu, tag push'unun tek başına canlıya çıkışı tetiklemesini engelleyen
      # ikinci bir güvenlik katmanı (birincisi: GitHub Environment onayı).
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Onaylanmış bir internal build'i production track'ine terfi ettirir"
  lane :promote_to_production do
    upload_to_play_store(
      package_name: "com.eva.app",
      json_key: "play-service-account.json",
      track: "internal",
      track_promote_to: "production",
      release_status: "draft",
    )
  end
end
