# .env.example (kök dizin)
# docker-compose.yml bu dosyayı ".env" adıyla otomatik okur (aynı dizindeyse).
# Kopyalayın: cp .env.example .env, sonra gerçek değerleri girin.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_API_KEY=dev_only_admin_key_minimum_32_characters_xx
REVENUECAT_WEBHOOK_AUTH_SECRET=dev_only_revenuecat_secret_min24

# Gateway <-> Python dahili servis kimlik doğrulaması — her iki tarafta da
# BİREBİR AYNI olmalı (docker-compose.yml her iki servise de bu değeri
# otomatik iletir).
INTERNAL_SERVICE_MASTER_SECRET=dev_only_internal_secret_min_32_characters_xx

# Gerçek CPO Aggregator sözleşmesi tamamlanana kadar boş bırakılabilir;
# Fiyat Tasarruf Ajanı bu adrese ulaşamazsa HATA döndürür ama servis
# çökmez (bkz. tariff_fetch_tool.py hata yönetimi).
OCPI_AGGREGATOR_BASE_URL=http://host.docker.internal:9999
OCPI_AGGREGATOR_API_KEY=dev_placeholder

# =====================================================================
# LLM SAGLAYICI SECIMI
# =====================================================================
# Iki is yuku ayri saglayiciya baglanabilir. Ayri saglayici = ayri kota
# havuzu: toplu fiyat kosusu (yuzlerce cagri) sesli yanitin rate
# limit'ini yemez.
#
#   pricing -> CrewAI + arac cagirma, gecikmeye toleransli, patlama halinde
#              50 istasyon x 2 gorev = ~100+ cagri
#   voice   -> tek adim, kati JSON, SURUCU BEKLIYOR -> gecikme kritik
#
# Gecerli degerler: anthropic | groq | gemini | openai_compatible
PRICING_LLM_PROVIDER=anthropic
VOICE_LLM_PROVIDER=anthropic

# Model adlari SAGLAYICI ONEKI OLMADAN yazilir ("gemini-2.0-flash" gibi);
# litellm onekini (gemini/, groq/) llm_factory otomatik ekler.
AGENT_MODEL_NAME=claude-sonnet-4-6
VOICE_AGENT_MODEL_NAME=claude-sonnet-4-6

# Anahtarlar: YALNIZCA secilen saglayicininki zorunludur. Yanlis/eksik
# birakirsaniz servis SESSIZCE degil, acilista net bir hatayla durur.
# Anahtar alma adresleri:
#   Groq   -> https://console.groq.com/keys        (kredi karti istemiyor)
#   Gemini -> https://aistudio.google.com/app/apikey (kredi karti istemiyor)
GROQ_API_KEY=
GEMINI_API_KEY=

# Listede olmayan herhangi bir OpenAI-uyumlu saglayici icin kacis kapisi
# (OpenRouter, Cerebras, LLM7.io, yerel vLLM/Ollama ...).
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
