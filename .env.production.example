# .env.production.example
#
# Uretim sunucusuna kopyalanip ".env" olarak doldurulur.
# Bu dosya SURUM KONTROLUNE GIRER (ornek), doldurulmus hali GIRMEZ.
#
# Her deger zorunludur: docker-compose.prod.yml eksik bir siri sessizce
# zayif bir varsayilanla degil, ACIK bir hatayla karsilar.

# --- Alan adi ve sertifika ---
EVA_DOMAIN=api.alan-adiniz.com
# Sertifika uyarilari (yakinda dolacak / yenilenemedi) bu adrese gider.
ACME_EMAIL=siz@alan-adiniz.com

# --- Veritabani ---
# Gelistirmedeki "eva_dev_password" ASLA kullanilmaz.
# Uretmek icin: openssl rand -base64 32
POSTGRES_USER=eva_prod
POSTGRES_PASSWORD=
POSTGRES_DB=eva_prod

# --- Redis ---
REDIS_PASSWORD=

# --- Sirlar (her biri en az 32 karakter) ---
# openssl rand -hex 32
ADMIN_API_KEY=
INTERNAL_SERVICE_MASTER_SECRET=

# RevenueCat panelindeki webhook ile AYNI olmali (en az 24 karakter).
REVENUECAT_WEBHOOK_AUTH_SECRET=

# Yalnizca bir web yuzeyi eklenirse. Bos birakilirsa Stripe ucu KAPALI
# kalir -- yapilandirilmamis bir odeme webhook'unu acik birakmak,
# herkesin kendine abonelik yazabilmesi demektir.
STRIPE_WEBHOOK_SECRET=

# --- Cihaz dogrulamasi (ZORUNLU) ---
#
# Play Integrity servis hesabi anahtarinin SUNUCUDAKI yolu. Bu dosya
# olmadan Gateway ACILMAZ -- Android dogrulamasinin tek dayanagi budur.
#
# Nasil alinir:
#   1. Google Cloud Console > IAM > Service Accounts > yeni hesap
#   2. Rol: "Play Integrity API" erisimi olan bir rol
#   3. Keys > Add key > JSON > indir
#   4. Sunucuya kopyala:  scp anahtar.json sunucu:/opt/eva/secrets/
#   5. Yolu buraya yaz. Dosya izni 600 olmali.
PLAY_INTEGRITY_KEY_FILE=/opt/eva/secrets/play-integrity.json

# --- iOS (su an KULLANILMIYOR) ---
#
# Urun Android; bir iOS istemcisi yayinlanana kadar bos birakin.
# Bos oldugunda sunucu normal acilir, yalnizca iOS attestation
# istekleri reddedilir.
APPLE_APP_ATTEST_ROOT_CA_BASE64=
APPLE_TEAM_ID=

# --- Dis servisler ---
OPENCHARGEMAP_API_KEY=
# Sunucu tarafi rota anahtari. Android SDK anahtari BURAYA KONMAZ --
# o anahtar Routes API'ye yetkili degildir ve olmamalidir.
GOOGLE_ROUTES_API_KEY=

# --- CORS ---
# "*" DEGIL. Yalnizca telemetri panelinin kokeni.
CORS_ALLOWED_ORIGINS=https://panel.alan-adiniz.com
TELEMETRY_PANEL_ORIGIN=https://panel.alan-adiniz.com

# Admin uclarina erisebilecek IP'ler (virgulle). Bos = kapali.
ADMIN_IP_ALLOWLIST=
