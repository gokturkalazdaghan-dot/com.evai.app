# .gitignore

# Ortam değişkenleri
.env
*.env
!.env.example
!*.env.example

# Node / NestJS
node_modules/
dist/
coverage/
npm-debug.log*

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
android/.cxx/
android/app/release/

# iOS / Xcode
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
ios/**/DerivedData/
ios/**/*.pbxuser
ios/Pods/

# Genel
.DS_Store
*.log
android/local.properties

# Eski dosya yedekleri (sir icerebilir)
_archive/

# --- Imza anahtarlari: ASLA surum kontrolune girmez ---
# Sizarsa, o anahtarla herkes uygulamaya guncelleme yayinlayabilir.
*.jks
*.keystore
*.p12
!**/debug.keystore
keystore.properties

# --- Yerel yapilandirma: GERCEK anahtarlari tasir ---
# Onceden yalnizca "android/local.properties" yaziliydi; kok dizindeki
# local.properties korumasizdi ve icinde Maps + RevenueCat anahtarlari
# vardi -- bir sonraki commit'te GitHub'a gidecekti.
local.properties
**/local.properties

# Test ve statik analiz ciktilari
.coverage
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
