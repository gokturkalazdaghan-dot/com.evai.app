POSTGRES_DSN=postgresql://postgres:eva_dev_password@localhost:5432/eva_dev
REDIS_URL=redis://localhost:6379

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_MODEL_NAME=claude-sonnet-4-6
VOICE_AGENT_MODEL_NAME=claude-sonnet-4-6
VOICE_AGENT_MAX_RESPONSE_CHARS=280

OCPI_AGGREGATOR_BASE_URL=http://mock-cpo-aggregator:9999
OCPI_AGGREGATOR_API_KEY=dev_placeholder
OCPI_REQUEST_TIMEOUT_SECONDS=8.0

MAX_STATIONS_PER_BATCH=50
TARIFF_CACHE_TTL_SECONDS=60
AGENT_RUN_INTERVAL_SECONDS=300

# Gateway'deki INTERNAL_SERVICE_MASTER_SECRET ile BİREBİR AYNI olmalı.
INTERNAL_SERVICE_MASTER_SECRET=change_me_shared_with_python_min_32_chars
