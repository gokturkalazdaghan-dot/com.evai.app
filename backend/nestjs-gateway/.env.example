# backend/nestjs-gateway/.env.example
# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun. .env asla
# commit edilmemeli (kök .gitignore'da zaten hariç tutuluyor).

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:eva_dev_password@localhost:5432/eva_dev
REDIS_URL=redis://localhost:6379

DEVICE_ATTESTATION_ENFORCED=false
ADMIN_API_KEY=change_me_minimum_32_characters_long_placeholder

APPLE_APP_BUNDLE_ID=com.eva.app
APPLE_TEAM_ID=CHANGE_ME
APPLE_APP_ATTEST_ROOT_CA_BASE64=

ANDROID_PACKAGE_NAME=com.eva.app
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/play-integrity-service-account.json

# RevenueCat Dashboard → Project Settings → Integrations → Webhooks
# bölümünde tanımladığınız secret ile birebir aynı olmalı.
REVENUECAT_WEBHOOK_AUTH_SECRET=change_me_minimum_24_characters

PRICE_AGENT_SERVICE_URL=http://price-saving-agent:8000
PRICE_AGENT_REGION_BATCH_SIZE=20
PRICE_AGENT_MAX_CONCURRENT_REGIONS=5

# Gateway <-> Python dahili servis kimlik doğrulaması (bkz.
# common/internal/internal-key.util.ts). Python .env'indeki
# INTERNAL_SERVICE_MASTER_SECRET ile BİREBİR AYNI olmalı. Min 32 karakter.
INTERNAL_SERVICE_MASTER_SECRET=change_me_shared_with_python_min_32_chars

# Opsiyonel — yalnızca /v1/admin/* altında endpoint eklerseniz devreye
# girer (bkz. common/middleware/ip-allowlist.middleware.ts). Boş bırakılırsa
# devre dışıdır.
ADMIN_IP_ALLOWLIST=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# xAI Grok — Eva sohbeti (POST /v1/eva/chat). Anahtarı https://console.x.ai
# adresinden alın. Boşsa uç 503 döner; gateway ayağa kalkmaya devam eder.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1
