<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Yakındaki şarj istasyonlarını bulmak için konum izni -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Sesli asistan (Voice Co-pilot) için mikrofon izni -->
    <!-- RevenueCat/Play Billing için gerekli -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
        Android 11+ paket gorunurlugu: bu tanim olmadan sistem, cihazda
        e-posta uygulamasi KURULU OLSA BILE mailto: intent'ini cozemez ve
        geri bildirim butonu her seferinde panoya kopyalamaya duserdi.
        Yalnizca e-posta yollayabilen uygulamalar sorgulanir; kurulu
        uygulama listesi taranmaz.
    -->
    <!--
        OBD-II dongle ile BLE baglantisi. Android 12+ ayri BLUETOOTH_*
        izinleri kullanir; oncesinde BLE TARAMASI konum izni ister
        (konum kullanmasak da sistem zorunlu tutar).
        usesPermissionFlags="neverForLocation": taramanin konum cikarimi
        icin KULLANILMADIGINI sisteme bildirir.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLE zorunlu DEGIL: dongle'i olmayan kullanici uygulamayi yine kurabilmeli. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Batarya uyarilari bildirimle veriliyor (Android 13+ izin ister). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".EvaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Eva"
        android:usesCleartextTraffic="false">

        <!-- Google Maps API anahtari. Deger local.properties'teki
             MAPS_API_KEY'den gelir (bkz. build.gradle.kts manifestPlaceholders).
             Bos ise harita katmani hic olusturulmaz. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Eva">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
