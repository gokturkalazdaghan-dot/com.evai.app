<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/data_extraction_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <!-- EncryptedSharedPreferences dosyası cihaz bulut yedeğine dahil
             edilmez — token'lar yeni cihaza taşınmamalı, oturum yeniden
             açılmalı. -->
        <exclude domain="sharedpref" path="com.eva.app.securetokenstore.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.eva.app.securetokenstore.xml" />
    </device-transfer>
</data-extraction-rules>
